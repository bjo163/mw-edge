{
  "name": "mw-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model-driven edge backend with an Odoo-inspired ORM for Cloudflare Workers and D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "pnpm test:unit && pnpm test:workers",
    "test:unit": "node --test test/*.test.js",
    "test:workers": "vitest run --config vitest.config.js",
    "db:migrate:local": "wrangler d1 migrations apply MW_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply MW_DB --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  },
  "packageManager": "pnpm@10.17.1"
}
